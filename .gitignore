# Secrets — never commit these
.env
.env.*
*.key
*.pem
service-role*
**/service_role*

# Supabase local state
.supabase/
supabase/.temp/
supabase/.branches/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Dependencies / build output (none today, but the repo should be ready)
node_modules/
dist/
build/
.cache/

# Local scratch
*.log
tmp/

# Capacitor: mobile/www is a generated staging copy of admin/ + shared/
# (see scripts/sync-mobile.js) -- admin/ and shared/ stay the one source of
# truth, this directory is rebuilt before every `cap sync`, never hand-edited.
mobile/www/

# Capacitor native projects ARE committed (the Xcode/Gradle project shells
# themselves), but their own build output and dependency caches are not --
# standard Capacitor project .gitignore entries.
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/capacitor-cordova-android-plugins/
ios/App/Pods/
ios/App/build/
ios/App/output/
ios/.xcode.env.local
ios/DerivedData/

# Official runtime ESM files are committed source assets, including dist/.
!/shared/vendor/
!/shared/vendor/**

# Local Python test caches
__pycache__/
*.py[cod]
