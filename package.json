{
  "name": "nova-shield",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "bash tests/run-regression.sh",
    "test:integration": "bash tests/run-integration.sh",
    "db:setup": "node tests/db/setup-test-db.mjs",
    "test:db": "bash tests/db/run-db-tests.sh",
    "db:rehearse": "node tests/db/setup-test-db.mjs && node tests/db/rehearse-pending.mjs",
    "sync:mobile": "node scripts/sync-mobile.js",
    "cap:sync": "npm run sync:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "test:admin": "bash tests/run-admin-suites.sh",
    "fixtures:daily-load": "node tests/db/setup-test-db.mjs && node tests/fixtures/build-daily-load-fixtures.mjs",
    "fixtures:completion": "node tests/db/setup-test-db.mjs && node tests/fixtures/build-completion-fixtures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaShield-Services/nova-shield.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NovaShield-Services/nova-shield/issues"
  },
  "homepage": "https://github.com/NovaShield-Services/nova-shield#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "pg": "^8.23.1"
  }
}
