    "reasoned_correction": {
      "description": "A correction APPENDS. The original consumption line stands as what the crew reported; the correction is a second row that links back to it, carries a reason and a name, and moves stock as an ADJUSTMENT rather than a second consumption. p_quantity is the signed change to the RECORD, so -3 puts three litres back on the shelf. Owner-only, and a blank reason is refused. A reopen works the same way and allows exactly one more completion, recorded as supersedes_corrections 1.",
      "correction_by_crew": {
        "refused": true,
        "sqlstate": "42501",
        "message": "Only the owner corrects an accepted material count: the original stands as what the crew reported."
      },
      "correction_without_a_reason": {
        "refused": true,
        "sqlstate": "22023",
        "message": "A correction without a reason is a rewrite"
      },
